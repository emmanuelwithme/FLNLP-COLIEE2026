# modernBert-fp-chunkAgg local configuration
# 中文註解：本檔會被 fine_tune.py / inference.py / similarity_and_rank.py 自動讀取。
# 中文註解：若同名環境變數已在 shell 內存在，程式會優先使用 shell 內的值，不會被本檔覆蓋。

# ========================
# 核心 chunk encoder 設定
# ========================
# 中文註解：每篇文件最多切成幾個 chunk。
TASK1_MAX_DOCUMENT_CHUNKS=3
# 中文註解：每個 chunk 的 token 上限，含 special tokens。
TASK1_DOCUMENT_CHUNK_LENGTH=4096
# 中文註解：encoder 每次前向最多送幾個 chunk；4096 token chunk 下保守使用 1。
TASK1_CHUNK_MICROBATCH_SIZE=1
# 中文註解：文件超過 3 chunks 時，先完整依句界切分，再取 first/middle/last。
TASK1_CHUNKAGG_LONG_DOCUMENT_SELECTION=head_middle_tail
# 中文註解：query/candidate/positive/negative 至少需要 100 個非空白字元才會進入訓練或推論。
TASK1_CHUNKAGG_MIN_DOCUMENT_CHARS=100
# 中文註解：precision 預設對齊成功訓練的 modernBert-fp：fp16=1, bf16=0, tf32=0。
TASK1_CHUNKAGG_FP16=1
TASK1_CHUNKAGG_BF16=0
TASK1_CHUNKAGG_ENABLE_TF32=0
# 中文註解：資料集層文字快取數量，減少重複讀檔。
TASK1_CHUNKAGG_TEXT_CACHE_SIZE=4096
# 中文註解：collator 層 chunk tokenization 快取數量，減少重複 tokenizer 開銷。
TASK1_CHUNKAGG_CHUNK_CACHE_SIZE=1024
# 中文註解：pin memory 保留；persistent workers 必須為 0，否則 worker 可能看不到每 epoch 更新後的 negatives。
TASK1_CHUNKAGG_PIN_MEMORY=1
TASK1_CHUNKAGG_PERSISTENT_WORKERS=0
# 中文註解：對齊成功 single-chunk 模型；它從 0.55555 學到 best epoch 的約 0.068。
TASK1_INIT_TEMPERATURE=0.55555
# 中文註解：限制的是 InfoNCE training temperature；optimizer step 後直接 clamp 參數。
TASK1_CHUNKAGG_TEMPERATURE_MIN=0.05
TASK1_CHUNKAGG_TEMPERATURE_MAX=2.0
# 中文註解：retrieval / adaptive negative sampling / inference 的文件編碼 batch size。
TASK1_RETRIEVAL_BATCH_SIZE=2

# ========================
# 訓練設定
# ========================
# 中文註解：1=只跑極少量資料做 smoke test，0=正式訓練。
TASK1_CHUNKAGG_QUICK_TEST=0
# 中文註解：QUICK_TEST 模式下最多抽多少 candidate / query。
TASK1_CHUNKAGG_QT_CAND_K=20
TASK1_CHUNKAGG_QT_QUERY_K=5
# 中文註解：訓練 batch 與 gradient accumulation。
TASK1_CHUNKAGG_TRAIN_BATCH_SIZE=1
TASK1_CHUNKAGG_GRAD_ACCUM_STEPS=4
TASK1_CHUNKAGG_EVAL_BATCH_SIZE=1
# 中文註解：固定使用 single-positive InfoNCE，epoch 對齊成功 single-chunk 模型。
TASK1_CHUNKAGG_NUM_EPOCHS=20
TASK1_CHUNKAGG_EARLY_STOPPING_PATIENCE=5
TASK1_CHUNKAGG_ENCODER_LR=5e-6
TASK1_CHUNKAGG_PROJECTOR_LR=1e-5
# 中文註解：v5 降低 fusion LR，避免新聚合分支比 backbone 更快主導文件向量。
TASK1_CHUNKAGG_FUSION_LR=1e-5
TASK1_CHUNKAGG_TEMPERATURE_LR=1e-4
TASK1_CHUNKAGG_WARMUP_RATIO=0.1
TASK1_CHUNKAGG_LR_SCHEDULER_TYPE=linear
TASK1_CHUNKAGG_NUM_WORKERS=2
TASK1_CHUNKAGG_SAVE_TOTAL_LIMIT=20
TASK1_CHUNKAGG_LOGGING_STEPS=50
# 中文註解：single-positive document InfoNCE 之外的 chunk-evidence InfoNCE。
TASK1_CHUNKAGG_EVIDENCE_LOSS_WEIGHT=0.2
TASK1_CHUNKAGG_EVIDENCE_POOL_TEMPERATURE=0.1
# 中文註解：fusion 只學 bounded residual；applied residual norm 永遠小於 0.5。
TASK1_CHUNKAGG_FUSION_RESIDUAL_MAX_NORM=0.5
# 中文註解：懲罰 raw residual 超過上限，避免長期飽和在 soft cap。
TASK1_CHUNKAGG_FUSION_RESIDUAL_PENALTY_WEIGHT=0.01
# 中文註解：epoch 0 使用初始 chunkAgg 模型；之後每個 epoch 使用上一輪結束後的模型重挖。
# 中文註解：target ESS > 0 時，每個 query 會依模型 score scale 自動校準 sampling temperature。
# 中文註解：先廣後難；epoch 8 起維持 ESS 300。若要固定難度可設成 0:300。
TASK1_CHUNKAGG_SAMPLING_TARGET_ESS_SCHEDULE=0:4000,2:2000,4:1000,6:500,8:300
# 中文註解：固定值只作 schedule 缺省邏輯的 fallback。
TASK1_CHUNKAGG_SAMPLING_TARGET_ESS=300
# 中文註解：以下 schedule 是 ESS 關閉時的 fallback；完整 scope 仍全部保留機率。
TASK1_CHUNKAGG_SAMPLING_TEMPERATURE=0.15
TASK1_CHUNKAGG_SAMPLING_TEMPERATURE_SCHEDULE=0:0.20,3:0.15,5:0.10
# 中文註解：負樣本固定每個 epoch 重挖，程式不提供跳過 epoch 的更新頻率開關。
TASK1_CHUNKAGG_MAX_NEGATIVES=15
# 中文註解：正式流程固定關閉跨 step late-cache，確保 loss 內所有 negatives 都來自每 epoch 的模型動態抽樣。

# ========================
# 推論 / 輸出命名
# ========================
# 中文註解：inference.py 與 similarity_and_rank.py 會共用這個模型名稱來決定 embeddings / ranking 檔名。
TASK1_CHUNKAGG_MODEL_NAME=modernBert_fp_chunkAgg_v5_fp16
# 中文註解：1=推論只編碼少量文件，0=正式產生全部 embeddings。
TASK1_CHUNKAGG_INFER_QUICK_TEST=0
# 中文註解：推論 QUICK_TEST 最多編碼多少篇文件。
TASK1_CHUNKAGG_INFER_QT_LIMIT=20

# ========================
# 路徑覆寫（需要時再打開）
# ========================
# 中文註解：若不設定，程式會使用 repo 內建的預設 backbone checkpoint。
# TASK1_CHUNKAGG_BASE_ENCODER_DIR=/abs/path/to/models/modernbert-caselaw-accsteps-fp/checkpoint-29000
# 中文註解：Trainer checkpoints 與 TensorBoard 的輸出根目錄。
TASK1_CHUNKAGG_OUTPUT_DIR=./models/modernBERT_contrastive_adaptive_fp_fp16_chunkAgg_scopeFilteredRaw_plus0_emptyExclude_2026_v5
# 中文註解：存 adaptive negatives 與 retrieval artifacts 的資料夾。
TASK1_CHUNKAGG_FINETUNE_DATA_DIR=./coliee_dataset/task1/2026/lht_process/modernBert-chunkAgg_scopeFilteredRaw_plus0_emptyExclude_v5/finetune_data
TASK1_CHUNKAGG_SCOPE_PATH=./coliee_dataset/task1/2026/lht_process/scope_compare/query_candidate_scope_raw_plus0_empty_exclude.json
TASK1_CHUNKAGG_VALID_JSON_PATH=./coliee_dataset/task1/2026/lht_process/modernBert_scopeFilteredRaw_plus0_emptyExclude/finetune_data/contrastive_bm25_hard_negative_top100_random15_valid.json
# 中文註解：inference.py 的輸入文件資料夾。
# TASK1_CHUNKAGG_CANDIDATE_DIR=/abs/path/to/processed
# TASK1_CHUNKAGG_QUERY_DIR=/abs/path/to/processed_new
# 中文註解：inference.py 輸出的 embeddings 檔案。
# 中文註解：similarity_and_rank.py 預設 query / candidate 都使用 processed；可用 *_EMB_SOURCE 切換。
# TASK1_CHUNKAGG_CAND_EMB_SOURCE=processed
# TASK1_CHUNKAGG_QUERY_EMB_SOURCE=processed
# TASK1_CHUNKAGG_CAND_EMB_PATH=/abs/path/to/processed_document_modernBert_fp_chunkAgg_v5_fp16_embeddings.pkl
# TASK1_CHUNKAGG_QUERY_EMB_PATH=/abs/path/to/processed_new_document_modernBert_fp_chunkAgg_v5_fp16_embeddings.pkl
# 中文註解：similarity_and_rank.py 的 query id 與輸出排名檔路徑。
# TASK1_CHUNKAGG_VALID_QID_PATH=/abs/path/to/valid_qid.tsv
# TASK1_CHUNKAGG_TRAIN_QID_PATH=/abs/path/to/train_qid.tsv
# TASK1_CHUNKAGG_SCOPE_PATH=/abs/path/to/query_candidate_scope.json
# TASK1_CHUNKAGG_OUTPUT_DOT_TRAIN=/abs/path/to/output_dot_train.tsv
# TASK1_CHUNKAGG_OUTPUT_DOT_VALID=/abs/path/to/output_dot_valid.tsv
# TASK1_CHUNKAGG_OUTPUT_COS_TRAIN=/abs/path/to/output_cos_train.tsv
# TASK1_CHUNKAGG_OUTPUT_COS_VALID=/abs/path/to/output_cos_valid.tsv
