# modernBert-fp-chunkAgg-v6 isolated configuration
# Shell values with the same TASK1_CHUNKAGG_V6_* name take precedence.
# Legacy TASK1_CHUNKAGG_* variables are intentionally ignored by v6.

# Model and chunking
TASK1_CHUNKAGG_V6_BASE_ENCODER_DIR=./models/modernbert-caselaw-accsteps-fp/checkpoint-29000
TASK1_CHUNKAGG_V6_MAX_DOCUMENT_CHUNKS=3
TASK1_CHUNKAGG_V6_DOCUMENT_CHUNK_LENGTH=4096
TASK1_CHUNKAGG_V6_CHUNK_MICROBATCH_SIZE=1
TASK1_CHUNKAGG_V6_LONG_DOCUMENT_SELECTION=head_middle_tail
TASK1_CHUNKAGG_V6_MIN_DOCUMENT_CHARS=100

# Precision and I/O resources
TASK1_CHUNKAGG_V6_FP16=1
TASK1_CHUNKAGG_V6_BF16=0
TASK1_CHUNKAGG_V6_ENABLE_TF32=0
TASK1_CHUNKAGG_V6_RETRIEVAL_BATCH_SIZE=2
TASK1_CHUNKAGG_V6_NUM_WORKERS=2
TASK1_CHUNKAGG_V6_PERSISTENT_WORKERS=0
TASK1_CHUNKAGG_V6_PIN_MEMORY=1
TASK1_CHUNKAGG_V6_TEXT_CACHE_SIZE=4096
TASK1_CHUNKAGG_V6_CHUNK_CACHE_SIZE=1024

# Training: keep the v5 architecture/loss optimizer settings.
TASK1_CHUNKAGG_V6_SEED=42
TASK1_CHUNKAGG_V6_INIT_TEMPERATURE=0.55555
TASK1_CHUNKAGG_V6_TEMPERATURE_MIN=0.05
TASK1_CHUNKAGG_V6_TEMPERATURE_MAX=2.0
TASK1_CHUNKAGG_V6_TRAIN_BATCH_SIZE=1
TASK1_CHUNKAGG_V6_GRAD_ACCUM_STEPS=4
TASK1_CHUNKAGG_V6_EVAL_BATCH_SIZE=1
TASK1_CHUNKAGG_V6_NUM_EPOCHS=20
TASK1_CHUNKAGG_V6_EARLY_STOPPING_PATIENCE=5
TASK1_CHUNKAGG_V6_ENCODER_LR=5e-6
TASK1_CHUNKAGG_V6_PROJECTOR_LR=1e-5
TASK1_CHUNKAGG_V6_FUSION_LR=1e-5
TASK1_CHUNKAGG_V6_TEMPERATURE_LR=1e-4
TASK1_CHUNKAGG_V6_WARMUP_RATIO=0.1
TASK1_CHUNKAGG_V6_LR_SCHEDULER_TYPE=linear
TASK1_CHUNKAGG_V6_SAVE_TOTAL_LIMIT=20
TASK1_CHUNKAGG_V6_LOGGING_STEPS=50

# Keep the v5 loss unchanged.
TASK1_CHUNKAGG_V6_EVIDENCE_LOSS_WEIGHT=0.2
TASK1_CHUNKAGG_V6_EVIDENCE_POOL_TEMPERATURE=0.1
TASK1_CHUNKAGG_V6_FUSION_RESIDUAL_MAX_NORM=0.5
TASK1_CHUNKAGG_V6_FUSION_RESIDUAL_PENALTY_WEIGHT=0.01

# Baseline-compatible dynamic negatives. Formal mode validates these exact values.
TASK1_CHUNKAGG_V6_SAMPLING_TEMPERATURE=1.0
TASK1_CHUNKAGG_V6_MAX_NEGATIVES=15

# Quick test and resume are isolated from legacy TASK1_* controls.
TASK1_CHUNKAGG_V6_QUICK_TEST=0
TASK1_CHUNKAGG_V6_QT_CAND_K=20
TASK1_CHUNKAGG_V6_QT_QUERY_K=1
TASK1_CHUNKAGG_V6_INFER_QUICK_TEST=0
TASK1_CHUNKAGG_V6_INFER_QT_LIMIT=20
TASK1_CHUNKAGG_V6_AUTO_RESUME=1
# TASK1_CHUNKAGG_V6_RESUME_FROM_CHECKPOINT=/absolute/path/to/v6/checkpoint-N

# Scope, labels and isolated artifacts
TASK1_CHUNKAGG_V6_SCOPE_PATH=./coliee_dataset/task1/2026/lht_process/scope_compare/query_candidate_scope_raw_plus0_empty_exclude.json
TASK1_CHUNKAGG_V6_VALID_JSON_PATH=./coliee_dataset/task1/2026/lht_process/modernBert_scopeFilteredRaw_plus0_emptyExclude/finetune_data/contrastive_bm25_hard_negative_top100_random15_valid.json
TASK1_CHUNKAGG_V6_OUTPUT_DIR=./models/modernBERT_contrastive_adaptive_fp_fp16_chunkAgg_scopeFilteredRaw_plus0_emptyExclude_2026_v6
TASK1_CHUNKAGG_V6_FINETUNE_DATA_DIR=./coliee_dataset/task1/2026/lht_process/modernBert-chunkAgg_scopeFilteredRaw_plus0_emptyExclude_v6/finetune_data
TASK1_CHUNKAGG_V6_MODEL_NAME=modernBert_fp_chunkAgg_v6_fp16
TASK1_CHUNKAGG_V6_RESULTS_DIR=./coliee_dataset/task1/2026/lht_process/modernBert_fp_chunkAgg_v6_fp16
TASK1_CHUNKAGG_V6_EMBEDDINGS_PATH=./coliee_dataset/task1/2026/lht_process/modernBert_fp_chunkAgg_v6_fp16/embeddings/processed.pkl

# Canonical post-training comparison reference
TASK1_CHUNKAGG_V6_BASELINE_CHECKPOINT=./models/modernBERT_contrastive_adaptive_fp_fp16_scopeFilteredRaw_plus0_emptyExclude_2026/checkpoint-11508
